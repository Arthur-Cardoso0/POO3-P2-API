DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
FRONTEND_URL="http://localhost:3000"
PORT=3333
# Senha usada só pelo seed de DESENVOLVIMENTO (defina uma sua, mín. 8 caracteres)
SEED_PASSWORD=""

# Usadas por `npm run admin:criar` (criar/redefinir o administrador real, inclusive em produção)
# ADMIN_NOME="Nome do Administrador"
# ADMIN_EMAIL="admin@dominio.com"
# ADMIN_SENHA="senha-forte-com-10+-caracteres"
# Opcional: máximo de conexões com o banco (ex.: 5 em planos gratuitos)
# DB_POOL_MAX=5
